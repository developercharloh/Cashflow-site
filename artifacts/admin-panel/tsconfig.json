{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["../task-earn-pro/src/*"] }
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/api.ts",
    "src/pages/kyc.tsx",
    "src/pages/kyc.test.tsx"
  ]
}
